# Absolute directory on the DGX containing policy-national-v1.sqlite.
POLICY_DATA_DIR=/srv/e-agent/policy-data
POLICY_DB_FILE=policy-national-v1.sqlite
# Optional /app/data/<release>.json; the manifest selects matching collections and embedding settings.
POLICY_RELEASE_MANIFEST_FILE=

# Bind the API to the DGX LAN interface. Restrict this port with the host firewall.
POLICY_API_BIND=172.27.153.44:18080

# Generate a long random value and keep this file outside Git.
POLICY_API_TOKEN_FILE=/srv/e-agent/policy-api/.secrets/policy-token

# Leave both collection names empty for SQLite-only retrieval.
POLICY_DOCUMENT_COLLECTION=policy-national-6bc6ed338ca5b809-combined
POLICY_PASSAGE_COLLECTION=policy-passages-build-96304174ffd64d27c759a3bc-qwen4b-v1
POLICY_RETRIEVAL_NETWORK=policy-retrieval
POLICY_EMBEDDING_URL=http://vllm-qwen3-embedding-4b:8000
POLICY_CHROMA_URL=http://chroma:8000
POLICY_EMBEDDING_MODEL=qwen3-embedding-4b
POLICY_SEMANTIC_TIMEOUT_MS=2000
POLICY_DOCUMENT_CANDIDATES=12
POLICY_PASSAGE_CANDIDATES=32
# Document collection uses squared L2; passage collection uses cosine distance.
POLICY_DOCUMENT_MAX_DISTANCE=0.9
POLICY_PASSAGE_MAX_DISTANCE=0.45
POLICY_EMBEDDING_CACHE_ENTRIES=256
