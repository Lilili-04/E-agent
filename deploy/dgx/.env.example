# Edit the address and browser authority for the target DGX.
HARNESS_BIND_ADDRESS=172.27.153.44
HARNESS_PORT=3080
HARNESS_TRUSTED_HOSTS=172.27.153.44:3080
HARNESS_IMAGE=e-agent-harness:local
HARNESS_NODE_IMAGE=node:24-bookworm-slim
# Before Compose commands: export HARNESS_SOURCE_REVISION="$(git rev-parse HEAD)"
HARNESS_STATE_DIR=/srv/e-agent/harness-state
HARNESS_WORKSPACE_DIR=/srv/e-agent/harness-workspace
POLICY_RETRIEVAL_NETWORK=policy-retrieval
POLICY_V2_DATA_DIR=/srv/e-agent/policy-v2
POLICY_V2_DB_FILE=policy-v2-national.sqlite
POLICY_V2_COMPATIBILITY_FILE=policy-v2-documents.compat.json
POLICY_EMBEDDING_URL=http://vllm-qwen3-embedding-4b:8000
POLICY_CHROMA_URL=http://chroma:8000
POLICY_EMBEDDING_MODEL=qwen3-embedding-4b
POLICY_DOCUMENT_COLLECTION=policy-national-6bc6ed338ca5b809-combined
POLICY_PASSAGE_COLLECTION=policy-passages-build-96304174ffd64d27c759a3bc-qwen4b-v1
POLICY_SEMANTIC_TIMEOUT_MS=5000
DGX_QWEN_API_BASE_URL=http://vllm-qwen36:8000/v1
# Host paths; only the file contents are mounted into the container.
QWEN_API_KEY_FILE=/srv/e-agent/harness-secrets/qwen-api-key
# Optional authenticated v2 API for a local Harness; use docker-compose.policy-api.yml.
POLICY_V2_API_PORT=18081
POLICY_V2_API_TOKEN_FILE=/srv/e-agent/harness-secrets/policy-v2-api-token
