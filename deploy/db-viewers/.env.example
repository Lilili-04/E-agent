# Shared DGX viewers for both Harness deployment modes.
VIEWERS_BIND_ADDRESS=172.27.153.44
SQLITE_VIEWER_PORT=18101
CHROMA_VIEWER_PORT=18102
POLICY_SQLITE_FILE=/srv/e-agent/policy-data/policy-national-v1.sqlite
VIEWERS_HTPASSWD_FILE=/srv/e-agent/db-viewers-secrets/viewers.htpasswd
POLICY_RETRIEVAL_NETWORK=policy-retrieval
CHROMA_UPSTREAM=chroma:8000
VIEWERS_DATASETTE_IMAGE=e-agent-datasette:0.65.5
VIEWERS_GATEWAY_IMAGE=e-agent-db-viewers:local
# Official images mirrored on AWS Public ECR; tested from the DGX network.
VIEWERS_PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
VIEWERS_NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
VIEWERS_NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.28-alpine
