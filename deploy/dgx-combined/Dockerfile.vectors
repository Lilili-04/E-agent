ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
RUN pip install --no-cache-dir chromadb==1.3.5
WORKDIR /app
COPY scripts/build-policy-local-vectors.py scripts/
COPY deploy/db-viewers/local-chroma.py deploy/db-viewers/
COPY deploy/dgx-combined/serve-vectors.py deploy/dgx-combined/
ENV ANONYMIZED_TELEMETRY=False
ENTRYPOINT ["python", "/app/deploy/dgx-combined/serve-vectors.py"]
