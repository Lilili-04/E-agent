worker_processes 1;
pid /tmp/history-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    access_log /dev/stdout;
    server_tokens off;
    client_max_body_size 1m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server {
        listen ${HISTORY_BIND_ADDRESS}:18103;
        auth_basic "E-agent database viewers";
        auth_basic_user_file /run/secrets/viewer_htpasswd;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        location / {
            limit_except GET { deny all; }
            proxy_set_header Authorization "";
            proxy_set_header Host 127.0.0.1:18106;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_pass http://127.0.0.1:18106;
        }
    }
}
